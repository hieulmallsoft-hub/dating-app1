# Application
NODE_ENV=development
PORT=3000

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DATABASE=dating_app

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
# Optional: comma-separated client IDs (Android/iOS/Web). Include all IDs that can issue idToken.
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
APPLE_CALLBACK_URL=http://localhost:3000/auth/apple/callback

# CORS
CORS_ORIGIN=http://localhost:5173

# Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
# Public base URL used in fileUrl response.
# For mobile, set to reachable host (example): http://192.168.1.10:3000/uploads
UPLOAD_PUBLIC_BASE_URL=
# Fallback base URL if UPLOAD_PUBLIC_BASE_URL is empty.
# Example: http://192.168.1.10:3000
APP_URL=

# Redis (optional)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase Cloud Messaging (optional, required for push notifications)
# Option A: put full service account JSON (one line).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: provide separate fields.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
